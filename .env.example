NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/company_profile
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SETUP_KEY=replace-with-a-private-setup-key

# Site configuration served to the frontend at runtime via GET /api/site-config
CONTACT_EMAIL=info@example.com
CONTACT_MOBILE=+91 00000 00000
CAREERS_EMAIL=hr@example.com
LINKEDIN_URL=https://in.linkedin.com/company/yourcompany
INSTAGRAM_URL=https://www.instagram.com/yourcompany/
FACEBOOK_URL=https://www.facebook.com/yourcompany
OFFICE_NAME=Your Company
OFFICE_LOCATION=City, State, India
OFFICE_ADDRESS=Full office address, City, State PIN
OFFICE_TIMEZONE=India Standard Time · UTC+5:30
OFFICE_HOURS=Monday to Saturday: 10:00am - 7:00pm
MAP_EMBED_URL=https://maps.google.com/maps?q=...&output=embed
MAP_DIRECTIONS_URL=https://maps.app.goo.gl/...

# Hero animations (public lottie.host asset URLs; leave empty to disable)
HOME_LOTTIE_URL=
CAREER_LOTTIE_URL=
CONTACT_LOTTIE_URL=
ABOUT_LOTTIE_URL=
ANDROID_LOTTIE_URL=
FLUTTER_LOTTIE_URL=
IOS_LOTTIE_URL=
UNITY_LOTTIE_URL=
UNITY_BACKGROUND_LOTTIE_URL=
ANGULAR_LOTTIE_URL=
TYPESCRIPT_LOTTIE_URL=
HTML5_LOTTIE_URL=

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://files.yourdomain.com

# Configure the R2 bucket CORS policy to allow PUT requests from CLIENT_ORIGIN
# with the Content-Type header. R2_PUBLIC_URL must be a public custom domain or
# an enabled r2.dev development URL for this bucket.
